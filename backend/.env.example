# --- Database ---
DATABASE_URL=postgresql+asyncpg://hdms_user:hdms_pass@postgres:5432/hdms_db

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# --- Encryption (Fernet key for Google refresh tokens) ---
FERNET_KEY=generate-with-python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- App ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
